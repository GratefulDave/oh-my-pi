{
  "mcp": {
    "context-mode": {
      "type": "local",
      "command": [
        "/Users/davidandrews/.local/bin/context-mode-mcp"
      ],
      "enabled": true,
      "_managed_by": "library"
    },
    "grep-app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
      "_managed_by": "library"
    },
    "codemap": {
      "type": "local",
      "command": [
        "node",
        "/Users/davidandrews/PycharmProjects/the-library/tools/codemap/server.mjs"
      ],
      "enabled": true,
      "_managed_by": "library"
    },
    "codebase-memory": {
      "type": "local",
      "command": [
        "codebase-memory-mcp"
      ],
      "enabled": true,
      "_managed_by": "library"
    },
    "ast-grep": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/ast-grep/ast-grep-mcp",
        "--with",
        "mcp<2",
        "ast-grep-server"
      ],
      "enabled": true,
      "_managed_by": "library"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "_managed_by": "library"
    }
  }
}