mcpServers:
  codemap:
    _managed_by: library
    command: node
    args:
    - /Users/davidandrews/PycharmProjects/the-library/tools/codemap/server.mjs
  ast-grep:
    _managed_by: library
    command: uvx
    args:
    - --from
    - git+https://github.com/ast-grep/ast-grep-mcp
    - ast-grep-server
    timeout: 15
  grep-app:
    _managed_by: library
    command: npx
    args:
    - -y
    - mcp-remote
    - https://mcp.grep.app
  context7:
    _managed_by: library
    command: npx
    args:
    - -y
    - mcp-remote
    - https://mcp.context7.com/mcp
  context-mode:
    _managed_by: library
    command: /Users/davidandrews/.local/bin/context-mode-mcp
  linear:
    _managed_by: library
    command: npx
    args:
    - -y
    - mcp-remote
    - https://mcp.linear.app/mcp
  chrome-devtools:
    _managed_by: library
    command: npx
    args:
    - -y
    - chrome-devtools-mcp@latest
