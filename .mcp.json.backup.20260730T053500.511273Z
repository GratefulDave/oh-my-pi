{
  "mcpServers": {
    "context7": {
      "_managed_by": "library"
    },
    "chrome-devtools": {
      "_managed_by": "library",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "grep-app": {
      "_managed_by": "library"
    },
    "smart-crusher-gateway": {
      "_managed_by": "library",
      "command": "smart-crusher-gateway",
      "args": [
        "serve"
      ],
      "env": {
        "SMART_CRUSHER_MCP_CONFIG": "~/.claude.json"
      }
    }
  }
}