{
	"type": "module",
	"name": "pi-distill",
	"version": "17.2.1",
	"description": "OMP extension for artifact-backed structured tool output compression",
	"author": "David Andrews",
	"license": "MIT",
	"keywords": [
		"omp",
		"extension",
		"compression",
		"mcp"
	],
	"scripts": {
		"build": "bun scripts/build-bundle.ts",
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"test": "bun test test",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"dependencies": {
		"yaml": "^2.9.0"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": "workspace:*",
		"@oh-my-pi/pi-tui": "workspace:*"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"omp": {
		"extensions": [
			"./dist/distill.bundle.js"
		]
	}
}
