{
	"type": "module",
	"name": "profile-manager",
	"version": "16.1.12-lex",
	"description": "OMP extension for model profile management",
	"author": "David Andrews",
	"license": "MIT",
	"keywords": ["omp", "extension", "profile-manager"],
	"scripts": {
		"build": "bun scripts/build-bundle.ts",
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"test": "bun test test",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"dependencies": {
		"@oh-my-pi/pi-utils": "workspace:*"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-agent-core": "workspace:*",
		"@oh-my-pi/pi-ai": "workspace:*",
		"@oh-my-pi/pi-coding-agent": "workspace:*"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"omp": {
		"extensions": ["./dist/profile-manager.bundle.js"]
	},
	"files": ["dist", "src", "README.md"]
}
