{
	"type": "module",
	"name": "@oh-my-pi/ag",
	"version": "15.10.3-lex",
	"description": "Self-contained Antigravity extension for OMP",
	"homepage": "https://omp.sh",
	"author": "Derek Rynd",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/can1357/oh-my-pi.git",
		"directory": "packages/ag"
	},
	"bugs": {
		"url": "https://github.com/can1357/oh-my-pi/issues"
	},
	"keywords": ["antigravity", "oauth", "extension"],
	"scripts": {
		"build": "bun scripts/build-bundle.ts",
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"test": "bun test test",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"dependencies": {
		"@oh-my-pi/pi-ai": "workspace:*",
		"@oh-my-pi/pi-catalog": "workspace:*",
		"@oh-my-pi/pi-utils": "workspace:*",
		"opencode-antigravity-auth": "1.6.5-beta.0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": "workspace:*"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"omp": {
		"extensions": ["./dist/ag.bundle.js"]
	},
	"files": ["src", "README.md"]
}
