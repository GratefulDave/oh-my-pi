{
	"type": "module",
	"name": "damage-control",
	"version": "16.1.12-lex",
	"description": "OMP extension for dangerous-command guardrails",
	"author": "David Andrews",
	"license": "MIT",
	"keywords": ["omp", "extension", "damage-control"],
	"scripts": {
		"build": "bun scripts/build-bundle.ts",
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": "workspace:*"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"omp": {
		"extensions": ["./dist/damage-control.bundle.js"]
	},
	"files": ["dist", "src", "README.md"]
}
