{
	"type": "module",
	"name": "pi-actor-swarm",
	"version": "17.2.14-lex",
	"description": "OMP extension for mailbox-driven multi-agent swarm coordination",
	"author": "David Andrews",
	"license": "MIT",
	"keywords": [
		"omp",
		"extension",
		"swarm",
		"multi-agent",
		"coordination"
	],
	"scripts": {
		"build": "bun scripts/build-bundle.ts",
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"test": "bun test test",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"dependencies": {
		"@oh-my-pi/pi-utils": "^17.2.14-lex"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": "workspace:*",
		"@oh-my-pi/pi-tui": "workspace:*"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"omp": {
		"extensions": [
			"./dist/swarm.bundle.js"
		]
	},
	"files": [
		"dist",
		"src",
		"README.md"
	]
}
