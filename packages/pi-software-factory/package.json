{
	"type": "module",
	"name": "pi-software-factory",
	"version": "17.2.3",
	"description": "OMP software factory scaffolding - init, doctor, and runtime extension for safety enforcement and workflow orchestration",
	"author": "David Andrews",
	"license": "MIT",
	"keywords": [
		"omp",
		"extension",
		"factory",
		"software-factory",
		"scaffold",
		"verifier"
	],
	"bin": {
		"factory-init": "./dist/bin/init.js",
		"factory-doctor": "./dist/bin/doctor.js"
	},
	"scripts": {
		"build": "bun scripts/build-bin.ts",
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"dependencies": {
		"@oh-my-pi/pi-utils": "^17.2.3"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": "workspace:*"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"omp": {
		"extensions": [
			"./dist/factory.bundle.js"
		]
	},
	"files": [
		"dist",
		"src",
		"README.md"
	]
}
