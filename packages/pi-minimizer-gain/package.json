{
	"type": "module",
	"name": "pi-minimizer-gain",
	"version": "17.2.2",
	"description": "OMP extension for visualizing native minimizer token savings and efficiency",
	"author": "David Andrews",
	"license": "MIT",
	"keywords": [
		"omp",
		"extension",
		"minimizer",
		"gain",
		"token-savings"
	],
	"scripts": {
		"build": "bun scripts/build-bundle.ts",
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"test": "bun test test",
		"smoke:bundle": "bun scripts/smoke-bundle-session-scope.mjs",
		"smoke:installed": "bun scripts/smoke-installed-session-scope.ts",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"dependencies": {
		"@oh-my-pi/pi-utils": "^17.2.2"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": "workspace:*",
		"@oh-my-pi/pi-tui": "workspace:*"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"omp": {
		"extensions": [
			"./dist/gaing.bundle.js"
		]
	},
	"files": [
		"dist",
		"src",
		"README.md"
	]
}
