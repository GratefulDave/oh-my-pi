{
	"type": "module",
	"name": "pi-antigravity-adapter",
	"version": "0.1.0",
	"description": "OMP provider adapter for the OpenCode Antigravity auth plugin",
	"homepage": "https://github.com/GratefulDave/oh-my-pi",
	"author": "David Andrews",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/GratefulDave/oh-my-pi.git",
		"directory": "packages/antigravity-adapter"
	},
	"bugs": {
		"url": "https://github.com/GratefulDave/oh-my-pi/issues"
	},
	"keywords": [
		"opencode",
		"antigravity",
		"oauth",
		"extension"
	],
	"scripts": {
		"build": "bun scripts/build-bundle.ts",
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"test": "bun test test",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"dependencies": {
		"@oh-my-pi/pi-ai": "workspace:*",
		"@oh-my-pi/pi-utils": "workspace:*",
		"opencode-antigravity-auth": "1.6.5-beta.0"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": "workspace:*"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"omp": {
		"extensions": [
			"./dist/antigravity.bundle.js"
		]
	},
	"files": [
		"dist",
		"src",
		"README.md"
	]
}
