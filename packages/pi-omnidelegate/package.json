{
	"type": "module",
	"name": "pi-omnidelegate",
	"version": "17.2.13-lex",
	"description": "OMP extension for delegating work to external AI agents (Claude, Codex, Gemini) via acpx/tmux/cmux",
	"author": "David Andrews",
	"license": "MIT",
	"keywords": [
		"omp",
		"extension",
		"delegate",
		"orchestration",
		"external-agents"
	],
	"scripts": {
		"build": "bun scripts/build-bundle.ts",
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"test": "bun test test",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"dependencies": {
		"@oh-my-pi/pi-utils": "^17.2.13-lex"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": "workspace:*",
		"@oh-my-pi/pi-tui": "workspace:*"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"omp": {
		"extensions": [
			"./dist/omnidelegate.bundle.js"
		]
	},
	"files": [
		"dist",
		"src",
		"README.md"
	]
}
