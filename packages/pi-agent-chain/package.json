{
	"type": "module",
	"name": "pi-agent-chain",
	"version": "15.10.3-lex",
	"description": "OMP extension for YAML-backed task chains and chain-aware prompt injection",
	"author": "David Andrews",
	"license": "MIT",
	"keywords": ["omp", "extension", "chain", "task"],
	"scripts": {
		"build": "bun scripts/build-bundle.ts",
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"test": "bun test test",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"dependencies": {
		"handlebars": "catalog:",
		"yaml": "^2.9.0"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": "workspace:*"
	},
	"devDependencies": {
		"zod": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"omp": {
		"extensions": ["./dist/agent-chain.bundle.js"]
	},
	"files": ["dist", "src", "CHANGELOG.md"]
}
